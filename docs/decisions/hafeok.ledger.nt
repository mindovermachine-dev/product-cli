<urn:sha256:b72a4aef034bead5739179511d64b1decc9e76cb2a9f3d382953f291cceeb2d7> <urn:ledger:ns#floorAtCreation> "T1" .
<urn:sha256:b72a4aef034bead5739179511d64b1decc9e76cb2a9f3d382953f291cceeb2d7> <urn:ledger:ns#hash> "sha256:b72a4aef034bead5739179511d64b1decc9e76cb2a9f3d382953f291cceeb2d7" .
<urn:sha256:b72a4aef034bead5739179511d64b1decc9e76cb2a9f3d382953f291cceeb2d7> <urn:ledger:ns#ofDecision> <urn:dec:hafeok.ledger/01KZR5PDTKMT7Z7R29AXMFRCWV> .
<urn:sha256:b72a4aef034bead5739179511d64b1decc9e76cb2a9f3d382953f291cceeb2d7> <urn:ledger:ns#set> <urn:ledger-set:ledger-design> .
<urn:sha256:b72a4aef034bead5739179511d64b1decc9e76cb2a9f3d382953f291cceeb2d7> <urn:ledger:ns#statement> "Acceptances never survive reconciliation. Acceptance signs a version hash; a reconciliation that produces a new version produces an unaccepted version — the prior acceptances remain in the log as historical facts about the exact versions they signed, and the reconciled version awaits fresh acceptance. No transfer, no inheritance, no close-enough: the same law as revise — content moves, acceptance does not follow it." .
<urn:sha256:b72a4aef034bead5739179511d64b1decc9e76cb2a9f3d382953f291cceeb2d7> <urn:ledger:ns#toleranceOverride> "T2" .
