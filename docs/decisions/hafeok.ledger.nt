<urn:sha256:3eda836d811b3d4f0671e71cbaff92c4e6e5db7a6bde078b8ae4133ef9c8f43b> <urn:ledger:ns#basedOn> "ruling:emil-2026-08-11#certificate-signing" .
<urn:sha256:3eda836d811b3d4f0671e71cbaff92c4e6e5db7a6bde078b8ae4133ef9c8f43b> <urn:ledger:ns#discharge> "analyzer:ledger-signing.revoked-key-review" .
