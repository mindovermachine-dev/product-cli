<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- One source. A package that is not on nuget.org needs an ADR that says
       where it comes from (ADR-0004). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Source mapping, so that a second source added later cannot silently
       serve an existing package id. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
