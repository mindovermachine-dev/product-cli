@prefix pf:   <https://productframework.org/ns#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#  The Product Framework — SHACL Conformance Shapes
#
#  These shapes validate that a product graph conforms to the
#  framework's rules. Run with pyshacl (or any SHACL engine):
#     pyshacl -s shapes.shacl.ttl -df turtle  your-product.ttl
#
#  Each shape's sh:message names the framework rule it enforces,
#  so a validation report reads as a conformance report.
#################################################################

#########################  WHAT — §3.1  #########################

pf:EntityShape a sh:NodeShape ;
  sh:targetClass pf:Entity ;
  sh:property [
    sh:path pf:definition ; sh:minCount 1 ;
    sh:message "§3.1 An entity must carry a business-language definition." ] ;
  sh:property [
    sh:path pf:inContext ; sh:minCount 1 ; sh:class pf:BoundedContext ;
    sh:message "§3.1 An entity must belong to exactly one bounded context (never a flat model)." ;
    sh:maxCount 1 ] ;
  sh:property [
    sh:path pf:hasAttribute ; sh:node pf:AttributeShape ;
    sh:message "§3.1 An entity attribute (when present) must name a field (attr_name); attr_type is optional." ] .

# An attribute is a blank node [ pf:attrName "…" ; pf:attrType "…"? ].
pf:AttributeShape a sh:NodeShape ;
  sh:property [
    sh:path pf:attrName ; sh:minCount 1 ;
    sh:message "§3.1 An entity attribute must name a field." ] .

pf:RelationShape a sh:NodeShape ;
  sh:targetClass pf:Relation ;
  sh:property [
    sh:path pf:cardinality ; sh:minCount 1 ;
    sh:message "§3.1 A relation must declare cardinality." ] ;
  sh:property [
    sh:path pf:rationale ; sh:minCount 1 ;
    sh:message "§3.1 A relation must carry rationale (why this link, this cardinality)." ] .

pf:BoundedContextShape a sh:NodeShape ;
  sh:targetClass pf:BoundedContext ;
  sh:property [
    sh:path rdfs:label ; sh:minCount 1 ;
    sh:message "A bounded context must be named (its ubiquitous language is authoritative)." ] .

pf:ContextMappingShape a sh:NodeShape ;
  sh:targetClass pf:ContextMapping ;
  sh:property [
    sh:path pf:mapsTo ; sh:minCount 2 ;
    sh:message "§3.1 A context mapping must connect two concepts (an explicit declared correspondence, never assumed)." ] ;
  sh:property [
    sh:path pf:rationale ; sh:minCount 1 ;
    sh:message "§3.1 A context mapping must state the correspondence (e.g. linked by PersonId)." ] .

pf:InvariantShape a sh:NodeShape ;
  sh:targetClass pf:Invariant ;
  sh:property [
    sh:path pf:statement ; sh:minCount 1 ;
    sh:message "§3.1 An invariant must be stated as a checkable constraint." ] .

#########################  WHAT — §3.2  #########################

pf:EventShape a sh:NodeShape ;
  sh:targetClass pf:Event ;
  sh:property [
    sh:path pf:changes ; sh:minCount 1 ; sh:class pf:Entity ;
    sh:message "§3.2 Every event must change a real domain entity (the load-bearing relation; behaviour may not reference structure that does not exist)." ] ;
  sh:property [
    sh:path pf:inContext ; sh:minCount 1 ; sh:class pf:BoundedContext ;
    sh:message "§3.2 An event must live in a bounded context." ] .

pf:CommandShape a sh:NodeShape ;
  sh:targetClass pf:Command ;
  sh:property [
    sh:path pf:targets ; sh:minCount 1 ; sh:class pf:Entity ;
    sh:message "§3.2 A command must target a real aggregate (entity)." ] ;
  sh:property [
    sh:path pf:emits ; sh:minCount 1 ; sh:class pf:Event ;
    sh:message "§3.2 A command must emit at least one event (command coverage)." ] .

pf:ReadModelShape a sh:NodeShape ;
  sh:targetClass pf:ReadModel ;
  sh:property [
    sh:path pf:projects ; sh:minCount 1 ;
    sh:message "§3.2 A read model must project at least one entity/event (read-model provenance: no ghost views)." ] .

####################  WHAT — §3.2.1 UI layer  ###################
#  A UI step's interactions are blank nodes pairing a target with
#  the AIO it is typed_as: pf:surfaces [ pf:projection … ;
#  pf:typedAs … ] and pf:offers [ pf:command … ; pf:typedAs … ].
#  The §3.2.1 rule: every interaction is typed against an AIO,
#  never a concrete control (a CIO).

pf:WireframeStepShape a sh:NodeShape ;
  sh:targetClass pf:WireframeStep ;
  sh:property [
    sh:path pf:surfaces ; sh:node pf:SurfaceShape ;
    sh:message "§3.2.1 A surfaced projection must be typed against an AIO." ] ;
  sh:property [
    sh:path pf:offers ; sh:node pf:OfferShape ;
    sh:message "§3.2.1 An offered command must be typed against an AIO." ] .

pf:SurfaceShape a sh:NodeShape ;
  sh:property [
    sh:path pf:projection ; sh:minCount 1 ; sh:class pf:ReadModel ;
    sh:message "§3.2.1 A surface interaction must show a real projection (read model)." ] ;
  sh:property [
    sh:path pf:typedAs ; sh:minCount 1 ; sh:class pf:Aio ;
    sh:message "§3.2.1 A UI step's interactions must be typed against an Abstract Interaction Object (an AIO), never a concrete control (a CIO)." ] .

pf:OfferShape a sh:NodeShape ;
  sh:property [
    sh:path pf:command ; sh:minCount 1 ; sh:class pf:Command ;
    sh:message "§3.2.1 An offer interaction must issue a real command." ] ;
  sh:property [
    sh:path pf:typedAs ; sh:minCount 1 ; sh:class pf:Aio ;
    sh:message "§3.2.1 A UI step's interactions must be typed against an Abstract Interaction Object (an AIO), never a concrete control (a CIO)." ] .

####################  WHAT — §3.7 actors  ########################
#  The product's authorization. Per-node shapes here; the strict
#  coverage checks (actor / scope / claim / provider, §6.3) are
#  graph-level and live in the conformance tooling.

pf:ActorKindShape a sh:NodeShape ;
  sh:targetClass pf:ActorKind ;
  sh:property [
    sh:path pf:actorNature ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "human" "process" "external" ) ;
    sh:message "§3.7 An actor kind must declare exactly one nature: human, process, or external." ] ;
  sh:property [
    sh:path pf:hasField ; sh:node pf:ClaimShape ;
    sh:message "§3.7 A claim must be named and typed from the §3.2 datatype vocabulary." ] .

pf:ClaimShape a sh:NodeShape ;
  sh:property [
    sh:path pf:attrName ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:message "§3.7 Every claim carries a name." ] ;
  sh:property [
    sh:path pf:attrType ; sh:maxCount 1 ; sh:in ( "string" "integer" "number" "boolean" "date" ) ;
    sh:message "§3.7 A claim's type comes from the §3.2 datatype vocabulary." ] ;
  sh:property [
    sh:path pf:claimMany ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
  sh:property [
    sh:path pf:valuesFrom ; sh:maxCount 1 ; sh:class pf:ReferenceSet ;
    sh:message "§3.7 A claim's values_from must be declared reference data (§3.1)." ] .

pf:TriggerActorShape a sh:NodeShape ;
  sh:targetClass pf:Trigger ;
  sh:property [
    sh:path pf:actsAs ; sh:maxCount 1 ; sh:class pf:ActorKind ;
    sh:message "§3.7 A trigger acts as at most one declared actor kind." ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "§3.7 A trigger's source admits one actor nature: user→human, automated→process, external→external." ;
    sh:select """
      SELECT $this ?actor WHERE {
        $this <https://productframework.org/ns#actsAs> ?actor ;
              <https://productframework.org/ns#source> ?source .
        ?actor <https://productframework.org/ns#actorNature> ?nature .
        FILTER ( (?source = "user" && ?nature != "human")
              || (?source = "automated" && ?nature != "process")
              || (?source = "external" && ?nature != "external") )
      }
    """ ;
  ] .

pf:StepActorShape a sh:NodeShape ;
  sh:targetClass pf:WireframeStep ;
  sh:property [
    sh:path pf:offeredTo ; sh:class pf:ActorKind ;
    sh:node [ sh:property [ sh:path pf:actorNature ; sh:hasValue "human" ] ] ;
    sh:message "§3.7 A UI step is offered only to declared human actor kinds — a process or external system acts through a trigger." ] .

pf:ViewScopeShape a sh:NodeShape ;
  sh:targetClass pf:ReadModel ;
  sh:property [
    sh:path pf:publicView ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
  sh:property [
    sh:path pf:scopedBy ; sh:node pf:ScopeRuleShape ;
    sh:message "§3.7 A scope rule names one declared actor kind and compares view fields with claims." ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "§3.7 A View is either public or scoped by the actor's claims, not both." ;
    sh:select """
      SELECT $this WHERE {
        $this <https://productframework.org/ns#publicView> true ;
              <https://productframework.org/ns#scopedBy> ?rule .
      }
    """ ;
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "§3.7 A View carries one scope rule per actor kind." ;
    sh:select """
      SELECT $this ?actor WHERE {
        $this <https://productframework.org/ns#scopedBy> ?r1 , ?r2 .
        ?r1 <https://productframework.org/ns#forActor> ?actor .
        ?r2 <https://productframework.org/ns#forActor> ?actor .
        FILTER ( ?r1 != ?r2 )
      }
    """ ;
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "§3.7 A scope rule reads only claims its actor kind carries." ;
    sh:select """
      SELECT $this ?claim WHERE {
        $this <https://productframework.org/ns#scopedBy> ?rule .
        ?rule <https://productframework.org/ns#forActor> ?actor ;
              <https://productframework.org/ns#scopeKey> ?key .
        ?key <https://productframework.org/ns#claim> ?claim .
        FILTER NOT EXISTS {
          ?actor <https://productframework.org/ns#hasField> ?f .
          ?f <https://productframework.org/ns#attrName> ?claim .
        }
      }
    """ ;
  ] .

pf:ScopeRuleShape a sh:NodeShape ;
  sh:property [
    sh:path pf:forActor ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pf:ActorKind ;
    sh:message "§3.7 A scope rule describes exactly one declared actor kind." ] ;
  sh:property [
    sh:path pf:scopeKey ; sh:node pf:ScopeKeyShape ] .

pf:ScopeKeyShape a sh:NodeShape ;
  sh:property [
    sh:path pf:viewField ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:message "§3.7 A scope key names the view field it compares." ] ;
  sh:property [
    sh:path pf:claim ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:message "§3.7 A scope key names the claim it compares with." ] .

#########################  HOW — §4  ############################
#  The How conformance shapes (decisions, principles, patterns,
#  the two contracts, layout, interface, and the trace-truth
#  rule) live in their own file: how.shacl.ttl. Loaded alongside
#  this one by validate.py.

#########################  WORK UNITS — §5  #####################

pf:WorkUnitShape a sh:NodeShape ;
  sh:targetClass pf:WorkUnit ;
  sh:property [
    sh:path pf:derivedFrom ; sh:minCount 1 ;
    sh:message "§5 A work unit must declare its (frozen) input — what it is derived_from." ] ;
  sh:property [
    sh:path pf:applies ; sh:minCount 0 ;
    sh:message "§5 A work unit references the principles/patterns it applies by pointer." ] .

#########################  VERIFICATION — §6  ###################

pf:VerificationShape a sh:NodeShape ;
  sh:targetClass pf:Verification ;
  sh:property [
    sh:path pf:enforces ; sh:minCount 1 ;
    sh:message "§6.1 Every verification must name what it protects (enforces a principle/contract/model element)." ] ;
  sh:property [
    sh:path pf:verificationKind ; sh:minCount 1 ; sh:class pf:VerificationKind ;
    sh:message "§6.2 A verification must declare its kind." ] .

#########################  DELIVERY — §7  #######################

pf:FeatureShape a sh:NodeShape ;
  sh:targetClass pf:Feature ;
  sh:property [
    sh:path pf:contains ; sh:minCount 1 ;
    sh:message "§7 A feature must be a non-empty subgraph of the What (flow-shaped, not a free-floating ticket)." ] .

pf:ReleaseShape a sh:NodeShape ;
  sh:targetClass pf:Release ;
  sh:property [
    sh:path pf:contains ; sh:minCount 1 ; sh:class pf:Feature ;
    sh:message "§7 A release must contain at least one feature; its cut must be closed (checked at validation time against dependencies)." ] .
