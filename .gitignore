/target
# FT-107 — the TC-889 external-consumer fixture builds in its own sibling target/.
product-cli/tests/fixtures/external-core-consumer/target/
Cargo.lock
.product.lock
*.product-tmp.*
.proptest-regressions
*:Zone.Identifier

# Product CLI — generated files
.product/graph/
.product/sessions/
.product/checklist.md
tests/__pycache__/

# session.json is the regenerable working cache; the committed <product>.ttl is
# the authoritative spec, and the session reloads from it (pf::session::load).
.product/products/*/session.json
# legacy pre-products/ location of the same cache
.product/author-domain/*/session.json

# build run I/O — frozen context, session metrics, logs (regenerable per `product build`)
.product/build/

# Playwright MCP scratch (headless browser profile/output)
.playwright-mcp/

# MSBuild intermediates under the C# fixture. A real `dotnet build` only runs
# for the DDD_LSP_E2E and SARIF-regeneration tests (committed SARIF covers CI),
# but an editor's C# language server restores the project on sight.
ddd-cli/tests/fixtures/csharp/obj/
ddd-cli/tests/fixtures/csharp/bin/
.decisions/index/

# Specification flow — observation, not the store. Run journals and judgements
# carry the model's reply text verbatim; the act store beside them (records,
# acts, policy, trust) IS committed, because `spec check` gates on it in CI and
# a branch carrying an unclosed record must not be able to merge.
.spec/runs/
.spec/judgements/
